# ─────────────────────────────────────────────────────
# AI Code Review Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o          # or gpt-4-turbo, gpt-3.5-turbo
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.2

# ── GitHub ───────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# ── GitLab ───────────────────────────────────────────
GITLAB_TOKEN=glpat-...
GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret
GITLAB_URL=https://gitlab.com   # Override for self-hosted instances

# ── Bitbucket ────────────────────────────────────────
BITBUCKET_USERNAME=your-username
BITBUCKET_APP_PASSWORD=your-app-password
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_WEBHOOK_SECRET=your-bitbucket-webhook-secret

# ── App Settings ─────────────────────────────────────
APP_ENV=development             # development | production
LOG_LEVEL=INFO
MAX_DIFF_SIZE_KB=500            # Skip reviewing diffs larger than this
REVIEW_COOLDOWN_SECONDS=60      # Prevent duplicate reviews on rapid pushes
