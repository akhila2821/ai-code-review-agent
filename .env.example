# ─────────────────────────────────────────────────────────
# CodeGuard AI — Environment Variables Template
#
# Copy this file to .env and fill in the real values.
# The .env file is listed in .gitignore and will NEVER
# be committed to GitHub.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────

# Your OpenAI API key (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# ── Optional (has sensible defaults) ─────────────────────

# Port the server listens on locally (Render sets this automatically)
PORT=3001

# Restrict CORS to your Render domain in production.
# Example: ALLOWED_ORIGIN=https://codeguard-ai.onrender.com
# Leave blank to allow all origins in local development.
ALLOWED_ORIGIN=

# Set to "production" on Render (Render sets this automatically)
NODE_ENV=development
